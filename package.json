{
  "name": "logquill",
  "version": "1.0.1",
  "description": "A logging framework with an identical mental model and JSON log shape across Node/TypeScript and Python.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./langchain": {
      "import": {
        "types": "./dist/langchain.d.ts",
        "default": "./dist/langchain.mjs"
      },
      "require": {
        "types": "./dist/langchain.d.cts",
        "default": "./dist/langchain.cjs"
      }
    },
    "./winston": {
      "import": {
        "types": "./dist/winston.d.ts",
        "default": "./dist/winston.mjs"
      },
      "require": {
        "types": "./dist/winston.d.cts",
        "default": "./dist/winston.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.mjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "langchain": [
        "./dist/langchain.d.ts"
      ],
      "winston": [
        "./dist/winston.d.ts"
      ],
      "browser": [
        "./dist/browser.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "imports": {
    "#span": {
      "browser": "./src/core/span-browser.ts",
      "node": "./src/core/span.ts",
      "default": "./src/core/span.ts"
    },
    "#context": {
      "browser": "./src/core/context-browser.ts",
      "node": "./src/core/context.ts",
      "default": "./src/core/context.ts"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.0.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "@google-cloud/logging": "^11.0.0",
    "@google-cloud/pubsub": "^4.0.0",
    "@langchain/core": "^1.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-logs-otlp-http": ">=0.220.0 <1.0.0",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.220.0 <1.0.0",
    "@opentelemetry/resources": "^2.0.0 || ^3.0.0",
    "@opentelemetry/sdk-logs": ">=0.220.0 <0.300.0 || ^3.0.0",
    "@opentelemetry/sdk-trace": "^2.0.0 || ^3.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "amqplib": "^0.10.0",
    "applicationinsights": "^3.0.0",
    "kafkajs": "^2.2.0",
    "mongodb": "^6.0.0",
    "mysql2": "^3.9.0",
    "nodemailer": "^6.9.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0 || ^5.0.0",
    "winston-transport": "^4.0.0",
    "yaml": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "winston-transport": {
      "optional": true
    },
    "yaml": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "redis": {
      "optional": true
    },
    "kafkajs": {
      "optional": true
    },
    "amqplib": {
      "optional": true
    },
    "@aws-sdk/client-sqs": {
      "optional": true
    },
    "@google-cloud/pubsub": {
      "optional": true
    },
    "@aws-sdk/client-cloudwatch-logs": {
      "optional": true
    },
    "@google-cloud/logging": {
      "optional": true
    },
    "applicationinsights": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/exporter-logs-otlp-http": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/sdk-logs": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "@opentelemetry/sdk-trace": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikhilvdev/logquill-js.git"
  },
  "bugs": {
    "url": "https://github.com/nikhilvdev/logquill-js/issues"
  },
  "homepage": "https://github.com/nikhilvdev/logquill-js#readme",
  "keywords": [
    "logging",
    "logger",
    "structured-logging",
    "json-logging",
    "observability",
    "typescript",
    "esm",
    "cjs",
    "node"
  ],
  "author": "Nikhil Arora <290192niks@gmail.com>",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "bench": "npm run build && node --expose-gc bench/memory.bench.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@langchain/core": "^1.2.9",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^5.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.27.7",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "pino": "^10.3.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^5.0.1",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0",
    "yaml": "^2.9.1"
  }
}
